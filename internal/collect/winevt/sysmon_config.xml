<!--
  Phylax Sysmon configuration (Balanced profile + CCDC includes). Schema 4.90 (Sysmon 15.x).

  Structure and rule families are derived from sysmon-modular by Olaf Hartong
  (MIT licence, https://github.com/olafhartong/sysmon-modular, "Balanced" profile
  generated by the repository's merge scripts), re-authored by hand for Phylax:
  every process is logged (the exec feed and the binary-integrity ledger need
  all of them), network/registry/file/image-load/pipe/WMI/DNS events use include
  lists for persistence and credential-theft locations, plus the CCDC additions
  from the design (LSASS access, named pipes, WMI, DNS, web-root file deletes).

  This is a starting point: volume-test it per host role in the lab (design:
  "Sysmon config is code") before relying on it. The Sysmon installer, driver
  rename (-d) and service rename are actions elsewhere; this file is only data.

  Event IDs consumed by the winevt module: 1,2,3,4,5,6,7,8,10,11,12,13,14,16,17,18,19,20,21,22,23,25,26.
-->
<Sysmon schemaversion="4.90">
  <HashAlgorithms>sha256,md5,imphash</HashAlgorithms>
  <CheckRevocation/>
  <EventFiltering>

    <!-- 1: ProcessCreate: log everything (exclude nothing). -->
    <RuleGroup name="ProcessCreate" groupRelation="or">
      <ProcessCreate onmatch="exclude"/>
    </RuleGroup>

    <!-- 2: FileCreateTime: timestomping from user-writable or system paths. -->
    <RuleGroup name="FileCreateTime" groupRelation="or">
      <FileCreateTime onmatch="include">
        <TargetFilename name="timestomp-system" condition="begin with">C:\Windows\</TargetFilename>
        <TargetFilename name="timestomp-users" condition="begin with">C:\Users\</TargetFilename>
        <TargetFilename name="timestomp-programdata" condition="begin with">C:\ProgramData\</TargetFilename>
      </FileCreateTime>
    </RuleGroup>

    <!-- 3: NetworkConnect: log all except loopback and the noisiest local chatter. -->
    <RuleGroup name="NetworkConnect" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <DestinationIp name="loopback4" condition="is">127.0.0.1</DestinationIp>
        <DestinationIp name="loopback6" condition="is">::1</DestinationIp>
        <DestinationIp name="linklocal6" condition="begin with">fe80:</DestinationIp>
        <DestinationIp name="multicast" condition="begin with">224.</DestinationIp>
        <DestinationIp name="mcast6" condition="begin with">ff02:</DestinationIp>
        <DestinationPort name="llmnr-mdns-ssdp" condition="is any">5353;5355;1900</DestinationPort>
      </NetworkConnect>
    </RuleGroup>

    <!-- 5: ProcessTerminate: all (lineage and lifetime). -->
    <RuleGroup name="ProcessTerminate" groupRelation="or">
      <ProcessTerminate onmatch="exclude"/>
    </RuleGroup>

    <!-- 6: DriverLoad: everything not signed by Microsoft Windows. -->
    <RuleGroup name="DriverLoad" groupRelation="or">
      <DriverLoad onmatch="exclude">
        <Signature name="ms-windows-signed" condition="contains">Microsoft Windows</Signature>
      </DriverLoad>
    </RuleGroup>

    <!-- 7: ImageLoad: unsigned or user-writable locations, credential/WMI/.NET loaders, scored-service DLLs. -->
    <RuleGroup name="ImageLoad" groupRelation="or">
      <ImageLoad onmatch="include">
        <Signed name="unsigned" condition="is">false</Signed>
        <ImageLoaded name="from-users" condition="begin with">C:\Users\</ImageLoaded>
        <ImageLoaded name="from-programdata" condition="begin with">C:\ProgramData\</ImageLoaded>
        <ImageLoaded name="from-temp" condition="contains">\Temp\</ImageLoaded>
        <ImageLoaded name="from-perflogs" condition="begin with">C:\PerfLogs\</ImageLoaded>
        <ImageLoaded name="dbghelp-lsass-dump" condition="end with">\dbghelp.dll</ImageLoaded>
        <ImageLoaded name="dbgcore-lsass-dump" condition="end with">\dbgcore.dll</ImageLoaded>
        <ImageLoaded name="samlib-cred" condition="end with">\samlib.dll</ImageLoaded>
        <ImageLoaded name="vaultcli-cred" condition="end with">\vaultcli.dll</ImageLoaded>
        <ImageLoaded name="wmi-scripting" condition="end with">\wbemdisp.dll</ImageLoaded>
        <ImageLoaded name="clr-in-unmanaged" condition="end with">\clr.dll</ImageLoaded>
        <ImageLoaded name="amsi-patch-target" condition="end with">\amsi.dll</ImageLoaded>
        <!-- CCDC: add scored-service binary directories per host role, e.g. C:\inetpub\, C:\Windows\System32\dns.exe children. -->
        <ImageLoaded name="iis-modules" condition="contains">\inetsrv\</ImageLoaded>
      </ImageLoad>
    </RuleGroup>

    <!-- 8: CreateRemoteThread: all except a few known-benign sources. -->
    <RuleGroup name="CreateRemoteThread" groupRelation="or">
      <CreateRemoteThread onmatch="exclude">
        <SourceImage name="csrss" condition="is">C:\Windows\System32\csrss.exe</SourceImage>
        <SourceImage name="wininit" condition="is">C:\Windows\System32\wininit.exe</SourceImage>
        <SourceImage name="winlogon" condition="is">C:\Windows\System32\winlogon.exe</SourceImage>
      </CreateRemoteThread>
    </RuleGroup>

    <!-- 9: RawAccessRead: all (disk reads that bypass file ACLs, NTDS/VSS tooling). -->
    <RuleGroup name="RawAccessRead" groupRelation="or">
      <RawAccessRead onmatch="exclude"/>
    </RuleGroup>

    <!-- 10: ProcessAccess: LSASS (CCDC addition) minus the standard system sources. -->
    <RuleGroup name="ProcessAccess" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage name="lsass" condition="end with">\lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- 11: FileCreate: executables/scripts in writable paths, startup, tasks, web roots, drivers. -->
    <RuleGroup name="FileCreate" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename name="exe-users" condition="contains any">C:\Users\;C:\ProgramData\;\Temp\;C:\PerfLogs\;C:\Windows\Tasks\</TargetFilename>
        <TargetFilename name="startup-folder" condition="contains">\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename name="system32-tasks" condition="begin with">C:\Windows\System32\Tasks\</TargetFilename>
        <TargetFilename name="web-root" condition="contains any">\inetpub\wwwroot\;\xampp\htdocs\;\htdocs\</TargetFilename>
        <TargetFilename name="drivers" condition="end with">.sys</TargetFilename>
        <TargetFilename name="ntds-dump" condition="end with">ntds.dit</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- 12/13/14: Registry: persistence, credential providers, Defender, IFEO, service parameters. -->
    <RuleGroup name="RegistryEvent" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject name="run-keys" condition="contains any">\CurrentVersion\Run;\CurrentVersion\RunOnce;\CurrentVersion\RunServices;\Policies\Explorer\Run</TargetObject>
        <TargetObject name="winlogon" condition="contains any">\Winlogon\Shell;\Winlogon\Userinit;\Winlogon\Notify;\Winlogon\Taskman</TargetObject>
        <TargetObject name="appinit" condition="contains any">\Windows\AppInit_DLLs;\Session Manager\BootExecute;\Session Manager\AppCertDlls</TargetObject>
        <TargetObject name="ifeo" condition="contains any">Image File Execution Options\;\SilentProcessExit\</TargetObject>
        <TargetObject name="lsa" condition="contains any">\Control\Lsa\Security Packages;\Control\Lsa\Authentication Packages;\Control\Lsa\Notification Packages;\Control\Lsa\RunAsPPL</TargetObject>
        <TargetObject name="services" condition="contains any">\Services\ImagePath;\Services\ServiceDll;\Services\FailureCommand</TargetObject>
        <TargetObject name="dns-plugin" condition="contains">\Services\DNS\Parameters\ServerLevelPluginDll</TargetObject>
        <TargetObject name="defender" condition="contains any">\Windows Defender\Exclusions\;\Windows Defender\DisableAntiSpyware;\Real-Time Protection\Disable</TargetObject>
        <TargetObject name="netlogon-zerologon" condition="contains">\Services\Netlogon\Parameters\FullSecureChannelProtection</TargetObject>
        <TargetObject name="com-hijack" condition="contains">\CLSID\{</TargetObject>
        <TargetObject name="wdigest" condition="contains">\WDigest\UseLogonCredential</TargetObject>
        <TargetObject name="terminal-services" condition="contains">\Terminal Server\fDenyTSConnections</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- 15: FileCreateStreamHash: downloaded-from-internet markers and ADS. -->
    <RuleGroup name="FileCreateStreamHash" groupRelation="or">
      <FileCreateStreamHash onmatch="include">
        <TargetFilename name="ads-exe" condition="contains any">.exe:;.ps1:;.dll:;.bat:;.vbs:</TargetFilename>
      </FileCreateStreamHash>
    </RuleGroup>

    <!-- 17/18: PipeEvent: well-known C2 framework pipe names plus anything under \\.\pipe\ with PSEXESVC style names. -->
    <RuleGroup name="PipeEvent" groupRelation="or">
      <PipeEvent onmatch="include">
        <PipeName name="cobaltstrike-msagent" condition="begin with">\msagent_</PipeName>
        <PipeName name="cobaltstrike-postex" condition="begin with">\postex_</PipeName>
        <PipeName name="cobaltstrike-status" condition="begin with">\status_</PipeName>
        <PipeName name="cobaltstrike-msse" condition="contains">\MSSE-</PipeName>
        <PipeName name="psexec" condition="contains any">\PSEXESVC;\paexec;\remcom;\csexec</PipeName>
        <PipeName name="meterpreter-default" condition="contains any">\msf-pipe;\meterpreter</PipeName>
        <PipeName name="sliver-like" condition="contains any">\mojo.5688.8052;\win_svc;\ntsvcs;\scerpc</PipeName>
        <PipeName name="lateral-svcctl" condition="is any">\svcctl;\atsvc;\winreg</PipeName>
      </PipeEvent>
    </RuleGroup>

    <!-- 19/20/21: WmiEvent: all permanent subscription activity. -->
    <RuleGroup name="WmiEvent" groupRelation="or">
      <WmiEvent onmatch="exclude"/>
    </RuleGroup>

    <!-- 22: DnsQuery: all, minus high-volume Microsoft update/connectivity names. -->
    <RuleGroup name="DnsQuery" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <QueryName name="windows-update" condition="end with any">.windowsupdate.com;.delivery.mp.microsoft.com;.msftconnecttest.com;.msftncsi.com</QueryName>
        <QueryName name="local-wpad" condition="is">wpad</QueryName>
      </DnsQuery>
    </RuleGroup>

    <!-- 23: FileDelete (archived): only web roots, to bound disk use (design). -->
    <RuleGroup name="FileDelete" groupRelation="or">
      <FileDelete onmatch="include">
        <TargetFilename name="web-root" condition="contains any">\inetpub\wwwroot\;\xampp\htdocs\;\htdocs\</TargetFilename>
      </FileDelete>
    </RuleGroup>

    <!-- 25: ProcessTampering: all (hollowing, herpaderping). -->
    <RuleGroup name="ProcessTampering" groupRelation="or">
      <ProcessTampering onmatch="exclude"/>
    </RuleGroup>

    <!-- 26: FileDeleteDetected: web roots (logged, not archived). -->
    <RuleGroup name="FileDeleteDetected" groupRelation="or">
      <FileDeleteDetected onmatch="include">
        <TargetFilename name="web-root" condition="contains any">\inetpub\wwwroot\;\xampp\htdocs\;\htdocs\</TargetFilename>
      </FileDeleteDetected>
    </RuleGroup>

  </EventFiltering>
</Sysmon>
