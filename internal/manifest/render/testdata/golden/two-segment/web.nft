# Generated by phylax from the manifest for host web. Do not edit.
# default: input drop, output drop

table inet phylax_mgmt
delete table inet phylax_mgmt
table inet phylax_mgmt {
	chain input {
		type filter hook input priority -10; policy accept;
		ip saddr 10.10.2.0/24 tcp dport 7444 ct state new ct mark set ct mark | 0x7068 accept comment "relay: agents of segment dmz (only the segment's manifest addresses)"
	}
	chain output {
		type filter hook output priority -10; policy accept;
		ip daddr 10.10.1.50/32 tcp dport 7443 ct state new ct mark set ct mark | 0x7068 accept comment "agent link to the controller"
	}
}

table inet phylax
delete table inet phylax
table inet phylax {
	chain input {
		type filter hook input priority 0; policy drop;
		iif lo accept comment "loopback"
		ct state invalid drop
		ct state established,related accept comment "established and related"
		ct mark & 0x7068 == 0x7068 accept comment "management flows (table phylax_mgmt)"
		meta l4proto icmp accept comment "ICMP stays (ping is scored; rules require ICMP)"
		meta l4proto ipv6-icmp accept comment "ICMPv6: neighbour discovery, PMTU, echo"
		udp sport 67 udp dport 68 accept comment "DHCP server reply"
		udp sport 547 udp dport 546 accept comment "DHCPv6 server reply"
		tcp dport 80 accept comment "web-http (http)"
		tcp dport 22 accept comment "web-ssh (ssh)"
		tcp dport 23 accept comment "decoy [telnet] (record only)"
		tcp dport 8081 accept comment "decoy [http_admin] (record only)"
	}
	chain output {
		type filter hook output priority 0; policy drop;
		oif lo accept comment "loopback"
		ct state invalid drop
		ct state established,related accept comment "established and related"
		ct mark & 0x7068 == 0x7068 accept comment "management flows (table phylax_mgmt)"
		meta l4proto icmp accept comment "ICMP stays (ping is scored; rules require ICMP)"
		meta l4proto ipv6-icmp accept comment "ICMPv6: neighbour discovery, PMTU, echo"
		udp sport 68 udp dport 67 accept comment "DHCP client request"
		udp sport 546 udp dport 547 accept comment "DHCPv6 client request"
		limit rate 100/second burst 200 packets log group 100 prefix "phylax-egress-deny: " comment "denied egress; the policy then drops"
	}
}

table inet phylax_nat
delete table inet phylax_nat
table inet phylax_nat {
	chain sinkhole {
		type nat hook output priority -100; policy accept;
		oif lo return
		ct state != new return
		ip daddr 10.10.1.50/32 tcp dport 7443 return comment "agent link to the controller"
		meta l4proto tcp redirect to :7480 comment "sinkhole: record what the implant would have said"
	}
}
