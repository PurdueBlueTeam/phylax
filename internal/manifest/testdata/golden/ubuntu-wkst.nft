# phylax firewall policy for ubuntu-wkst (mode: enforce)
# Generated from the manifest; do not hand-edit.
table inet phylax {
    chain in {
        type filter hook input priority 0; policy drop;
        iif "lo" accept comment "phylax:lo"
        ct state established,related accept comment "phylax:conntrack"
        ip saddr {172.20.242.30, 172.20.242.40, 172.20.242.50, 172.25.32.144} meta l4proto tcp tcp dport 7443 accept comment "phylax:agent-in"
    }
    chain out {
        type filter hook output priority 0; policy drop;
        oif "lo" accept comment "phylax:lo"
        ct state established,related accept comment "phylax:conntrack"
        ip daddr 172.20.242.10 meta l4proto tcp tcp dport 7443 accept comment "phylax:agent"
        log group 1 prefix "phylax-denied: " drop comment "phylax:default-deny"
    }
}
