# phylax firewall policy for fedora-webmail (mode: enforce)
# Generated from the manifest; do not hand-edit.
table inet phylax {
    chain in {
        type filter hook input priority 0; policy drop;
        iif "lo" accept comment "phylax:lo"
        ct state established,related accept comment "phylax:conntrack"
        meta l4proto tcp tcp dport 110 accept comment "phylax:svc:webmail-pop3"
        meta l4proto tcp tcp dport 25 accept comment "phylax:svc:webmail-smtp"
        meta l4proto tcp tcp dport 22 accept comment "phylax:svc:webmail-ssh"
        meta l4proto tcp tcp dport 23 accept comment "phylax:decoy:telnet"
    }
    chain out {
        type filter hook output priority 0; policy drop;
        oif "lo" accept comment "phylax:lo"
        ct state established,related accept comment "phylax:conntrack"
        ip daddr 172.20.242.10 meta l4proto tcp tcp dport 7443 accept comment "phylax:agent"
        ip daddr 172.20.240.20 meta l4proto tcp tcp dport 389 accept comment "phylax:dep:webmail-pop3"
        ip daddr 172.20.240.20 meta l4proto udp udp dport 88 accept comment "phylax:dep:webmail-pop3"
        ip daddr 172.20.240.20 meta l4proto udp udp dport 53 accept comment "phylax:dep:webmail-pop3"
        ip daddr 172.20.240.20 meta l4proto udp udp dport 53 accept comment "phylax:dep:webmail-smtp"
        meta l4proto tcp log group 1 prefix "phylax-sinkhole: " redirect to 127.0.0.1:47443 comment "phylax:sinkhole"
        log group 1 prefix "phylax-denied: " drop comment "phylax:default-deny"
    }
}
