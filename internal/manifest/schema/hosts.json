{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phylax/manifest/hosts.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["team", "hosts"],
  "properties": {
    "team": { "type": "integer", "minimum": 0 },
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment", "ip", "os"],
        "properties": {
          "segment": { "type": "string", "minLength": 1 },
          "ip": { "type": "string", "format": "ipv4" },
          "public_ip": { "type": "string" },
          "os": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family"],
            "properties": {
              "family": { "enum": ["debian", "redhat", "windows"] },
              "distro": { "type": "string" },
              "version": { "type": "string" }
            }
          },
          "default_creds": { "type": "string" },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["relay", "device_proxy", "check_runner", "decoys", "capture"]
            }
          }
        }
      }
    }
  }
}
