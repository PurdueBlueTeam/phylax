{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phylax/manifest/devices.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["devices"],
  "properties": {
    "devices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["vendor", "admin", "segment"],
        "properties": {
          "vendor": { "enum": ["palo", "vyos"] },
          "admin": { "type": "string" },
          "segment": { "type": "string" },
          "adapter": { "type": "string" },
          "via": { "type": "string" },
          "backup_target": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
