{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phylax/manifest/policy.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["tiers", "protected_process", "retention", "limits", "patch_window"],
  "properties": {
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier0_actions"],
      "properties": {
        "tier0_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "protected_process": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "evidence"],
      "properties": {
        "events": { "type": "string" },
        "evidence": { "type": "string" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spool_max_mb", "packet_ring_max_mb", "packet_ring_pct_free",
                   "tier0_per_host_per_min"],
      "properties": {
        "spool_max_mb": { "type": "integer", "minimum": 1 },
        "packet_ring_max_mb": { "type": "integer", "minimum": 1 },
        "packet_ring_pct_free": { "type": "integer", "minimum": 1, "maximum": 100 },
        "tier0_per_host_per_min": { "type": "integer", "minimum": 1 },
        "agent_msg_rate_per_sec": { "type": "integer", "minimum": 1 },
        "agent_bytes_per_min": { "type": "integer", "minimum": 1 }
      }
    },
    "patch_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_sec", "allowlist"],
      "properties": {
        "duration_sec": { "type": "integer", "minimum": 60 },
        "allowlist": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
