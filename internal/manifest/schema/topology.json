{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phylax/manifest/topology.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["controller", "segments"],
  "properties": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "agent_port", "ui"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "agent_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "ui": { "type": "string", "pattern": "^127\\.0\\.0\\.1:[0-9]+$" }
      }
    },
    "segments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cidr", "firewall"],
        "properties": {
          "cidr": { "type": "string" },
          "firewall": { "type": "string", "minLength": 1 },
          "relay": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "port"],
            "properties": {
              "host": { "type": "string" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          },
          "nat": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relay_public", "controller_public"],
            "properties": {
              "relay_public": { "type": "string" },
              "controller_public": { "type": "string" }
            }
          }
        }
      }
    },
    "backups": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
