[Unit]
Description=System network helper
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
ExecStart=/opt/udev-netd/kern-logd-9f8e7d agent run --state-dir "/var/lib/my dir"
Restart=always
RestartSec=1
# KillMode=process: a stop must not kill the detached swap helper that
# agent.replace_binary and agent.rename leave behind to restart the agent;
# a control-group kill would leave the host without a running agent.
KillMode=process
OOMScoreAdjust=-900
MemoryMax=256M
CPUQuota=50%
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
# The agent needs full root, so there is no filesystem protection, no capability set and no
# namespace isolation here. Hardening only removes what it never uses.

[Install]
WantedBy=multi-user.target
