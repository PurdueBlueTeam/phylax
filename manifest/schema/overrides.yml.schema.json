{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "overrides": {
      "additionalProperties": false,
      "properties": {
        "accepted_findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "subject",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "act": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "adopted_drift": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              }
            },
            "required": [
              "subject"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "inject_changes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              }
            },
            "required": [
              "subject"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "learned_listeners": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "port": {
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "proto": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "host",
              "proto",
              "port",
              "reason",
              "observed"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "safe_mode_hosts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "required": [
    "overrides"
  ],
  "title": "Phylax overrides.yml",
  "type": "object"
}
