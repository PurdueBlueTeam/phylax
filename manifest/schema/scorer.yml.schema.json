{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "scorer": {
      "additionalProperties": false,
      "properties": {
        "credlists": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "delay": {
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "type": "string"
        },
        "engine": {
          "enum": [
            "quotient"
          ],
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "jitter": {
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "type": "string"
        },
        "known": {
          "type": "boolean"
        },
        "poll_portal": {
          "enum": [
            "off",
            "ask_organizers",
            "operator_paste",
            "cookie_poll"
          ],
          "type": "string"
        },
        "portal": {
          "type": "string"
        },
        "sla_threshold": {
          "type": "integer"
        },
        "timeout": {
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "type": "string"
        }
      },
      "required": [
        "engine"
      ],
      "type": "object"
    }
  },
  "required": [
    "scorer"
  ],
  "title": "Phylax scorer.yml",
  "type": "object"
}
